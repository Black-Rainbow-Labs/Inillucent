# Two differences the nightly random matrix found on seeds 20261005 to 20261007.
#
# LIMIT 0 runs nothing, so a term that would fail on a row is never evaluated. And
# LIKE or GLOB become an index range only over a column with TEXT affinity: an untyped
# column keeps an integer as an integer, which no text range reaches.

setup

statement ok
CREATE TABLE t0(a REAL, b INTEGER)

statement ok
INSERT INTO t0 VALUES (NULL, -9223372036854775808)

statement ok
CREATE TABLE g(a, b BLOB)

statement ok
INSERT INTO g VALUES (1, 2), ('12', 3), ('2', 4)

statement ok
CREATE INDEX g_i ON g(a)

statement ok
CREATE TABLE gt(a TEXT, b)

statement ok
INSERT INTO gt VALUES ('12', 1), ('2', 2), (1, 3)

statement ok
CREATE INDEX gt_i ON gt(a)

case limit-zero-evaluates-nothing

query I rowsort
SELECT abs(b) FROM t0 WHERE abs(b) > 0 LIMIT 0

case limit-zero-with-an-offset-and-an-order

query I rowsort
SELECT abs(b) FROM t0 ORDER BY 1 LIMIT 0 OFFSET 2

case limit-zero-over-an-aggregate

query I rowsort
SELECT count(*) FROM t0 LIMIT 0

case glob-over-an-untyped-index

query T rowsort
SELECT a, b FROM g WHERE a GLOB '1*'

case glob-over-a-text-index

query T rowsort
SELECT a, b FROM gt WHERE a GLOB '1*'
