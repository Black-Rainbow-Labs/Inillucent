# Differential cases, category `known-bugs-fixed`: entries of the known bugs list that later work fixed without a test of their own.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
#
# task-2110 found these answering as SQLite 3.53.4 does at release 2.7.0, each fixed in passing by
# later work and each with nothing that would fail if it broke again. A VIRTUAL generated column's
# affinity and collation (bug 18), an FTS5 join whose MATCH names a column with the FTS5 table first
# (bug 19), INSERT OR FAIL where a foreign key and a UNIQUE constraint both fail (bug 35), LIKE through
# an index over BLOB values (bug 37) and a correlated scalar subquery with no FROM used as a value
# (bug 38).

generated-virtual-affinity-collation	CREATE TABLE g (a INTEGER, c TEXT COLLATE NOCASE GENERATED ALWAYS AS ('X' || a) VIRTUAL, d INTEGER GENERATED ALWAYS AS (a || '0') VIRTUAL);\nINSERT INTO g (a) VALUES (1), (2), (3);\nSELECT a FROM g WHERE c = 'x3';\nSELECT typeof(d), d FROM g WHERE a = 1;\nSELECT a FROM g ORDER BY c DESC;\nSELECT c, count(*) FROM g GROUP BY c ORDER BY 1;\nCREATE INDEX g_c ON g(c);\nSELECT a FROM g WHERE c = 'x2';\nSELECT a FROM g WHERE c COLLATE BINARY = 'x2';
fts5-match-column-other-term	CREATE VIRTUAL TABLE f USING fts5(body);\nINSERT INTO f VALUES ('red apple'), ('green pear'), ('red cherry');\nCREATE TABLE q (word TEXT);\nINSERT INTO q VALUES ('red'), ('pear');\nSELECT q.word, f.body FROM f, q WHERE f.body MATCH q.word ORDER BY 1, 2;\nSELECT q.word, f.body FROM q, f WHERE f.body MATCH q.word ORDER BY 1, 2;\nSELECT q.word, f.body FROM f, q WHERE f MATCH q.word ORDER BY 1, 2;\nSELECT q.word, f.body FROM q, f WHERE f MATCH q.word ORDER BY 1, 2;
insert-or-fail-foreign-key-and-unique	PRAGMA foreign_keys = ON;\nCREATE TABLE p(id INTEGER PRIMARY KEY);\nCREATE TABLE c(id INTEGER PRIMARY KEY, pid REFERENCES p(id), u UNIQUE);\nINSERT INTO p VALUES (1);\nINSERT INTO c VALUES (10, 1, 'x');\nINSERT OR FAIL INTO c VALUES (20, 99, 'y'), (30, 1, 'x');\nSELECT * FROM c ORDER BY id;
like-index-over-blobs	CREATE TABLE t(x);\nINSERT INTO t VALUES ('abc'), (x'616263'), ('abd'), (x'616264'), ('b'), (x'62');\nCREATE INDEX tx ON t(x);\nSELECT typeof(x), hex(x) FROM t WHERE x LIKE 'ab%' ORDER BY x;\nSELECT typeof(x), hex(x) FROM t WHERE x LIKE 'ab%' ORDER BY x DESC;\nSELECT count(*) FROM t NOT INDEXED WHERE x LIKE 'ab%';\nPRAGMA case_sensitive_like = ON;\nSELECT typeof(x), hex(x) FROM t WHERE x LIKE 'ab%' ORDER BY x;
correlated-scalar-without-from	CREATE TABLE t1(a);\nCREATE TABLE t2(x);\nINSERT INTO t1 VALUES (1), (2);\nINSERT INTO t2 VALUES (1), (3);\nSELECT a, x FROM t1, t2 WHERE t1.a = (SELECT x) ORDER BY 1;\nCREATE TABLE aa(y);\nCREATE TABLE bb(x);\nINSERT INTO aa VALUES (1), (2);\nINSERT INTO bb VALUES (10), (20);\nSELECT (SELECT sum(x + (SELECT y)) FROM bb) FROM aa ORDER BY 1;
